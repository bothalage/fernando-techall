{{!-- subject: 🔔 Ticket #{{ticket.shortId}} is now {{ticket.status}} --}}
<h2 style="margin:0 0 12px;color:#fff">Ticket status updated</h2>
<p style="color:#cbd5e1">Hi {{user.name}}, the status of your ticket <strong>{{ticket.subject}}</strong> changed to <strong style="text-transform:capitalize">{{ticket.status}}</strong>.</p>
{{#if note}}<blockquote style="border-left:3px solid #a855f7;margin:14px 0;padding:6px 14px;color:#cbd5e1">{{note}}</blockquote>{{/if}}
<p><a href="{{appUrl}}/dashboard" style="background:linear-gradient(135deg,#3b82f6,#a855f7);color:#fff;padding:10px 18px;border-radius:10px;text-decoration:none">View ticket</a></p>
