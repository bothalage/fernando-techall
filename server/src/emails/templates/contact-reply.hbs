{{!-- subject: Re: {{contact.subject}} --}}
<h2 style="margin:0 0 12px;color:#fff">Hi {{contact.name}},</h2>
<div style="color:#e6ecff;line-height:1.6">{{{reply}}}</div>
<hr style="border:none;border-top:1px solid #2a3170;margin:18px 0"/>
<p style="color:#8aa0d6;font-size:12px">Your original message:</p>
<blockquote style="border-left:3px solid #3b82f6;margin:8px 0;padding:6px 14px;color:#8aa0d6;font-size:13px">{{contact.message}}</blockquote>
