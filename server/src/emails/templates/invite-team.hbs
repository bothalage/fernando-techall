{{!-- subject: You're invited to join {{company}} on Fernando TechAll --}}

<div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell', sans-serif; max-width: 600px; margin: 0 auto; padding: 20px;">
  <div style="background: linear-gradient(135deg, #4e5cff 0%, #ad4eff 100%); color: white; padding: 30px; border-radius: 12px; text-align: center; margin-bottom: 20px;">
    <h1 style="margin: 0; font-size: 24px;">{{brand}}</h1>
    <p style="margin: 10px 0 0 0; opacity: 0.9;">Team Invitation</p>
  </div>

  <div style="background: #f9f9f9; padding: 20px; border-radius: 8px; margin-bottom: 20px;">
    <p style="margin: 0 0 15px 0; font-size: 16px; color: #333;">Hi {{email}},</p>
    
    <p style="margin: 0 0 15px 0; font-size: 14px; color: #666; line-height: 1.6;">
      <strong>{{invitedByName}}</strong> has invited you to join <strong>{{company}}</strong> on Fernando TechAll as a <strong>{{role}}</strong>.
    </p>

    <p style="margin: 0 0 20px 0; font-size: 14px; color: #666; line-height: 1.6;">
      Click the button below to accept this invitation and get started.
    </p>

    <a href="{{acceptLink}}" style="display: inline-block; background: linear-gradient(135deg, #4e5cff 0%, #ad4eff 100%); color: white; padding: 12px 30px; border-radius: 8px; text-decoration: none; font-weight: 600; margin-bottom: 20px;">
      Accept Invitation
    </a>

    <p style="margin: 0; font-size: 12px; color: #999;">
      This invitation expires in 7 days. If the button doesn't work, copy and paste this link:<br>
      <code style="background: white; padding: 2px 6px; border-radius: 3px; font-size: 11px;">{{acceptLink}}</code>
    </p>
  </div>

  <div style="border-top: 1px solid #eee; padding-top: 15px; text-align: center; font-size: 12px; color: #999;">
    <p style="margin: 0;">© {{year}} {{brand}}. All rights reserved.</p>
  </div>
</div>
